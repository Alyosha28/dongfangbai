---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import PaperItem from '../components/PaperItem.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { estimateReadTime, getPapers, getProfile, getProjects, normalizeDate } from '../lib/data';
import { getUi, localizePath, type Locale } from '../lib/i18n';

export interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const ui = getUi(locale);
const profile = getProfile(locale);
const papers = getPapers(locale).filter((p) => p.featured);
const projects = getProjects(locale).filter((p) => p.featured);

const thoughts = (await getCollection('thoughts'))
  .filter((t) => !t.data.draft)
  .sort((a, b) => normalizeDate(b.data.date).localeCompare(normalizeDate(a.data.date)))
  .slice(0, 5);
---
<Site view="home" locale={locale}>
  <section class="intro-hero" aria-labelledby="intro-heading">
    <div class="intro-primary">
      <h1 class="intro-title" id="intro-heading">
        {locale === 'zh' ? profile.nativeName || profile.name : profile.name}
      </h1>
      <p class="intro-native" lang={locale === 'zh' ? 'en' : 'zh-CN'}>
        <span>{locale === 'zh' ? profile.name : profile.nativeName}</span>
        <span class="intro-dot" aria-hidden="true">·</span>
        <span lang="zh-CN">{profile.moniker}</span>
      </p>
      <p class="intro-lead">{profile.tagline}</p>
      <p class="intro-sub">{profile.bio[0]}</p>

      <div class="intro-actions">
        <a class="intro-more-link" href={localizePath('/about', locale)}>
          <span>{ui.home.moreAboutMe}</span>
          <Icon name="arrow-right" size={14} />
        </a>
        <div class="intro-channels">
          {profile.links.map((link) => (
            <a
              href={link.url}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              <span>{link.label}</span>
              {link.external && <Icon name="arrow-up-right" size={14} />}
            </a>
          ))}
        </div>
      </div>
    </div>

    <aside class="intro-colophon" aria-label={ui.home.epigraphAria}>
      <div class="colophon-compose">
        <p class="colophon-epigraph" lang="zh-CN">「{profile.epigraph}」</p>
        <div class="colophon-meta">
          <p class="colophon-source" lang="zh-CN">{profile.epigraphAttribution}</p>
          <button
            type="button"
            class="colophon-seal-btn"
            id="heroSealBtn"
            aria-label={ui.home.sealAria}
            title="歌未竟，东方白"
          >
            <Icon name="seal" size={34} solid={true} />
          </button>
        </div>
      </div>
    </aside>
  </section>

  <section class="home-section" aria-labelledby="papers-heading">
    <div class="section-head">
      <h2 id="papers-heading">{ui.home.papersHeading}</h2>
      <a class="section-more" href={localizePath('/papers', locale)}>
        <span>{ui.home.allPapers}</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
    <div class="ledger-list ledger-list--interactive">
      {papers.map((paper, idx) => (
        <PaperItem
          paper={paper}
          locale={locale}
          showDetails={false}
          linkToDetail={true}
          compact={true}
          showSummary={idx === 0}
        />
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">{ui.home.projectsHeading}</h2>
      <a class="section-more" href={localizePath('/projects', locale)}>
        <span>{ui.home.allProjects}</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
    <div class="ledger-list ledger-list--interactive">
      {projects.map((project) => (
        <ProjectItem
          project={project}
          locale={locale}
          showHighlights={false}
          linkToDetail={true}
          compact={true}
        />
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="thoughts-heading">
    <div class="section-head">
      <h2 id="thoughts-heading">{ui.home.thoughtsHeading}</h2>
      <a class="section-more" href={localizePath('/thoughts', locale)}>
        <span>{ui.home.allThoughts}</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
    <div class="ledger-list ledger-list--interactive">
      {thoughts.map((thought) => {
        const dateIso = normalizeDate(thought.data.date);
        const readTime = estimateReadTime(thought.body ?? '', thought.data.readTime, locale);
        return (
          <article class="thought-row">
            <div class="thought-row-main">
              <a
                class="thought-row-title"
                href={localizePath(`/thoughts/${thought.slug}`, locale)}
                lang={thought.data.lang === 'zh' ? 'zh-CN' : 'en'}
              >
                {thought.data.title}
              </a>
              {thought.data.subtitle && (
                <p class="thought-row-sub" lang={thought.data.lang === 'zh' ? 'zh-CN' : 'en'}>
                  {thought.data.subtitle}
                </p>
              )}
            </div>
            <div class="thought-row-meta">
              <time datetime={dateIso}>{dateIso}</time>
              <span class="meta-dot" aria-hidden="true">·</span>
              <span>{readTime}</span>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Site>
