---
import Site from '../layouts/Site.astro';
import ProjectItem from '../components/ProjectItem.astro';
import { getProfile, getProjects } from '../lib/data';

const profile = getProfile();
const projects = getProjects();
---
<Site
  view="projects"
  title={`Projects — ${profile.name}`}
  description={`Selected quantitative research systems, empirical studies, and open-source work by ${profile.name}.`}
>
  <header class="page-header page-header--flush">
    <h1>Projects</h1>
    <p class="page-intro">
      Empirical research systems, cross-asset event studies, and personal software projects.
    </p>
  </header>

  <div class="ledger-list ledger-list--detail">
    {projects.map((project) => (
      <ProjectItem project={project} showHighlights={true} headingLevel="h2" />
    ))}
  </div>
</Site>
