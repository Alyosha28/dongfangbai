---
import '../styles/site.css';
import CommandPalette from '../components/CommandPalette.astro';
import Icon from '../components/Icon.astro';
import PixelPet from '../components/PixelPet.astro';
import { getProfile } from '../lib/data';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh-CN';
  view?: 'home' | 'projects' | 'papers' | 'thoughts' | 'thought' | 'about' | '404';
  showProgress?: boolean;
  wide?: boolean;
}

const profile = getProfile();
const {
  title = profile.siteTitle,
  description = profile.description,
  lang = 'en',
  view = 'home',
  showProgress = false,
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Home', active: pathname === '/' },
  { href: '/projects', label: 'Projects', active: pathname.startsWith('/projects') },
  { href: '/papers', label: 'Papers', active: pathname.startsWith('/papers') },
  { href: '/thoughts', label: 'Thoughts', active: pathname.startsWith('/thoughts') },
  { href: '/about', label: 'About', active: pathname.startsWith('/about') },
];

const expectAttrs = { blocking: 'render' } as Record<string, string>;
const cmdInvokeAttrs = {
  commandfor: 'commandPalette',
  command: 'show-modal',
} as Record<string, string>;

const inkOptions = [
  { id: 'plum', label: 'Dawn Plum', cn: '曙紫' },
  { id: 'cinnabar', label: 'Cinnabar Seal', cn: '朱砂' },
  { id: 'celadon', label: 'Song Celadon', cn: '天青' },
  { id: 'noir', label: 'Ink Noir', cn: '松烟' },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    try {
      const saved = localStorage.getItem('color-scheme');
      const meta = document.querySelector('meta[name="color-scheme"]');
      if (meta && (saved === 'light' || saved === 'dark')) {
        meta.content = saved;
      }
      const ink = localStorage.getItem('site-ink');
      if (ink === 'plum' || ink === 'cinnabar' || ink === 'celadon' || ink === 'noir') {
        document.documentElement.dataset.ink = ink;
      }
    } catch {}
  </script>
  <link rel="expect" href="#main-content" {...expectAttrs} />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={profile.siteTitle} href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;600;700&family=Source+Sans+3:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body id="top">
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <div class="site-horizon" aria-hidden="true"></div>
  {showProgress && <div class="read-progress" id="readProgress" aria-hidden="true"></div>}

  <header class="site-header" id="siteHeader" lang="en">
    <div class="header-inner">
      <a class="site-brand" href="/">
        <Icon name="seal" size={20} class="site-brand-seal" />
        <span class="site-brand-name">{profile.name}</span>
        <span class="site-brand-cn" lang="zh-CN">{profile.moniker}</span>
      </a>

      <div class="header-controls">
        <nav class="site-nav" aria-label="Primary">
          <button
            class="menu-button"
            type="button"
            popovertarget="site-menu"
            popovertargetaction="toggle"
            aria-controls="site-menu"
          >
            <Icon name="menu" size={16} />
            <span class="menu-button-label">Menu</span>
          </button>

          <ul id="site-menu" class="site-menu" popover="auto">
            {navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button
          class="cmd-trigger"
          id="cmdTrigger"
          type="button"
          aria-label="Open quick index"
          title="Quick Index (Cmd/Ctrl + K)"
          {...cmdInvokeAttrs}
        >
          <Icon name="search" size={15} />
          <kbd class="cmd-kbd" aria-hidden="true">
            <Icon name="command" size={11} />
            <span>K</span>
          </kbd>
        </button>

        <button class="theme-toggle" id="themeToggle" type="button">
          <span class="icon-moon" aria-hidden="true">
            <Icon name="moon" size={16} />
          </span>
          <span class="icon-sun" aria-hidden="true">
            <Icon name="sun" size={16} />
          </span>
          <span class="sr-only label-to-dark">Switch to dark theme</span>
          <span class="sr-only label-to-light">Switch to light theme</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content" class="site-main">
    <div class={wide ? 'page-shell--wide' : 'page-shell'}>
      <div class="print-letterhead" aria-hidden="true">
        <span class="print-letterhead-name">{profile.name}</span>
        <span class="print-letterhead-meta">{profile.domain}</span>
      </div>
      <slot />
    </div>
  </main>

  <footer class="site-footer" lang="en">
    <div class="footer-inner">
      <div class="footer-colophon">
        <span class="footer-epigraph" lang="zh-CN">{profile.epigraph}</span>
        <span class="footer-domain">{profile.domain}</span>
      </div>

      <div class="footer-right">
        <div class="ink-switcher" data-ink-switcher role="group" aria-label="Editorial ink edition">
          <span class="ink-switcher-label" id="inkCurrentLabel">Dawn Plum</span>
          <div class="ink-dots">
            {inkOptions.map((ink) => (
              <button
                type="button"
                class="ink-swatch"
                data-ink-option={ink.id}
                data-ink-label={ink.label}
                aria-label={`${ink.label} (${ink.cn}) ink`}
                aria-pressed={ink.id === 'plum' ? 'true' : 'false'}
                title={`${ink.label} · ${ink.cn}`}
              >
                <span class={`ink-dot ink-dot--${ink.id}`} aria-hidden="true"></span>
              </button>
            ))}
          </div>
        </div>

        <div class="footer-links">
          {profile.links.map((link) => (
            <a
              href={link.url}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </footer>

  <CommandPalette />
  <PixelPet view={view} />

  <script>
    import { initSite } from '../scripts/site';
    initSite();
  </script>
</body>
</html>
