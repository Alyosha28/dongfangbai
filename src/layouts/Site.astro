---
import '../styles/site.css';
import CommandPalette from '../components/CommandPalette.astro';
import Icon from '../components/Icon.astro';
import PixelPet from '../components/PixelPet.astro';
import { getProfile } from '../lib/data';
import { getAlternatePath, getUi, localizePath, type Locale } from '../lib/i18n';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh-CN';
  locale?: Locale;
  view?: 'home' | 'projects' | 'papers' | 'thoughts' | 'thought' | 'about' | '404';
  showProgress?: boolean;
  wide?: boolean;
}

const {
  locale = 'en',
  view = 'home',
  showProgress = false,
  wide = false,
} = Astro.props;

const profile = getProfile(locale);
const ui = getUi(locale);
const title = Astro.props.title ?? profile.siteTitle;
const description = Astro.props.description ?? profile.description;
const lang = Astro.props.lang ?? (locale === 'zh' ? 'zh-CN' : 'en');
const chromeLang = locale === 'zh' ? 'zh-CN' : 'en';

const pathname = Astro.url.pathname;
const normalizedPath = pathname.length > 1 ? pathname.replace(/\/+$/, '') : pathname;
const homeHref = localizePath('/', locale);
const projectsHref = localizePath('/projects', locale);
const papersHref = localizePath('/papers', locale);
const thoughtsHref = localizePath('/thoughts', locale);
const aboutHref = localizePath('/about', locale);

const navItems = [
  { href: homeHref, label: ui.nav.home, active: normalizedPath === homeHref },
  { href: projectsHref, label: ui.nav.projects, active: normalizedPath.startsWith(projectsHref) },
  { href: papersHref, label: ui.nav.papers, active: normalizedPath.startsWith(papersHref) },
  { href: thoughtsHref, label: ui.nav.thoughts, active: normalizedPath.startsWith(thoughtsHref) },
  { href: aboutHref, label: ui.nav.about, active: normalizedPath.startsWith(aboutHref) },
];

const targetLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const alternateHref = view === '404' ? localizePath('/', targetLocale) : getAlternatePath(pathname, targetLocale);
const enCanonicalPath = view === '404' ? '/' : getAlternatePath(pathname, 'en');
const zhCanonicalPath = view === '404' ? '/zh' : getAlternatePath(pathname, 'zh');

const expectAttrs = { blocking: 'render' } as Record<string, string>;
const cmdInvokeAttrs = {
  commandfor: 'commandPalette',
  command: 'show-modal',
} as Record<string, string>;

const inkOptions = [
  { id: 'plum', label: 'Dawn Plum', cn: '曙紫' },
  { id: 'cinnabar', label: 'Cinnabar Seal', cn: '朱砂' },
  { id: 'celadon', label: 'Song Celadon', cn: '天青' },
  { id: 'noir', label: 'Ink Noir', cn: '松烟' },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    try {
      const saved = localStorage.getItem('color-scheme');
      const meta = document.querySelector('meta[name="color-scheme"]');
      if (meta && (saved === 'light' || saved === 'dark')) {
        meta.content = saved;
      }
      const ink = localStorage.getItem('site-ink');
      if (ink === 'plum' || ink === 'cinnabar' || ink === 'celadon' || ink === 'noir') {
        document.documentElement.dataset.ink = ink;
      }
    } catch {}
  </script>
  <link rel="expect" href="#main-content" {...expectAttrs} />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {view !== '404' && (
    <>
      <link rel="alternate" hreflang="en" href={`${profile.siteUrl}${enCanonicalPath}`} />
      <link rel="alternate" hreflang="zh-CN" href={`${profile.siteUrl}${zhCanonicalPath}`} />
      <link rel="alternate" hreflang="x-default" href={`${profile.siteUrl}${enCanonicalPath}`} />
    </>
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;600;700&family=Source+Sans+3:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body id="top">
  <a class="skip-link" href="#main-content">{ui.skipToContent}</a>

  <div class="site-horizon" aria-hidden="true"></div>
  {showProgress && <div class="read-progress" id="readProgress" aria-hidden="true"></div>}

  <header class="site-header" id="siteHeader" lang={chromeLang}>
    <div class="header-inner">
      <a class="site-brand" href={homeHref}>
        <Icon name="seal" size={20} class="site-brand-seal" />
        <span class="site-brand-name">{profile.name}</span>
        {(profile.moniker || profile.nativeName) && (
          <span class="site-brand-cn" lang="zh-CN">{profile.moniker || profile.nativeName}</span>
        )}
      </a>

      <div class="header-controls">
        <nav class="site-nav" aria-label={ui.nav.primaryLabel}>
          <button
            class="menu-button"
            type="button"
            popovertarget="site-menu"
            popovertargetaction="toggle"
            aria-controls="site-menu"
          >
            <Icon name="menu" size={16} />
            <span class="menu-button-label">{ui.nav.menu}</span>
          </button>

          <ul id="site-menu" class="site-menu" popover="auto">
            {navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button
          class="cmd-trigger"
          id="cmdTrigger"
          type="button"
          aria-label={ui.header.openQuickIndex}
          title={ui.header.quickIndexTitle}
          {...cmdInvokeAttrs}
        >
          <Icon name="search" size={15} />
          <kbd class="cmd-kbd" aria-hidden="true">
            <Icon name="command" size={11} />
            <span>K</span>
          </kbd>
        </button>

        <a
          class="lang-toggle"
          id="langToggle"
          href={alternateHref}
          hreflang={targetLocale === 'zh' ? 'zh-CN' : 'en'}
          lang={targetLocale === 'zh' ? 'zh-CN' : 'en'}
          aria-label={ui.header.langToggleAria}
          title={ui.header.langToggleTitle}
          data-lang-switch={targetLocale}
        >
          {ui.header.langToggleText}
        </a>

        <button class="theme-toggle" id="themeToggle" type="button">
          <span class="icon-moon" aria-hidden="true">
            <Icon name="moon" size={16} />
          </span>
          <span class="icon-sun" aria-hidden="true">
            <Icon name="sun" size={16} />
          </span>
          <span class="sr-only label-to-dark">{ui.header.switchToDark}</span>
          <span class="sr-only label-to-light">{ui.header.switchToLight}</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content" class="site-main">
    <div class={wide ? 'page-shell--wide' : 'page-shell'}>
      <div class="print-letterhead" aria-hidden="true">
        <span class="print-letterhead-name">{profile.name}</span>
        <span class="print-letterhead-meta">{profile.domain}</span>
      </div>
      <slot />
    </div>
  </main>

  <footer class="site-footer" lang={chromeLang}>
    <div class="footer-inner">
      <div class="footer-colophon">
        <span class="footer-epigraph" lang="zh-CN">{profile.epigraph}</span>
        <span class="footer-domain">{profile.domain}</span>
      </div>

      <div class="footer-right">
        <div class="ink-switcher" data-ink-switcher role="group" aria-label={ui.footer.inkGroupAria}>
          <span class="ink-switcher-label" id="inkCurrentLabel">
            {locale === 'zh' ? inkOptions[0].cn : inkOptions[0].label}
          </span>
          <div class="ink-dots">
            {inkOptions.map((ink) => (
              <button
                type="button"
                class="ink-swatch"
                data-ink-option={ink.id}
                data-ink-label={locale === 'zh' ? ink.cn : ink.label}
                aria-label={locale === 'zh' ? `${ink.cn}（${ink.label}）印色` : `${ink.label} (${ink.cn}) ink`}
                aria-pressed={ink.id === 'plum' ? 'true' : 'false'}
                title={`${ink.label} · ${ink.cn}`}
              >
                <span class={`ink-dot ink-dot--${ink.id}`} aria-hidden="true"></span>
              </button>
            ))}
          </div>
        </div>

        <div class="footer-links">
          {profile.links.map((link) => (
            <a
              href={link.url}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </footer>

  <CommandPalette locale={locale} alternateHref={alternateHref} />
  <PixelPet view={view} />

  <script>
    import { initSite } from '../scripts/site';
    initSite();
  </script>
</body>
</html>
