---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { getPapers, getProfile, getProjects, normalizeDate } from '../lib/data';
import { getUi, localizePath, type Locale } from '../lib/i18n';

export interface Props {
  locale?: Locale;
  alternateHref?: string;
}

const { locale = 'en', alternateHref = locale === 'zh' ? '/' : '/zh' } = Astro.props;
const ui = getUi(locale);
const profile = getProfile(locale);
const papers = getPapers(locale);
const projects = getProjects(locale);
const thoughts = (await getCollection('thoughts'))
  .filter((t) => !t.data.draft)
  .sort((a, b) => normalizeDate(b.data.date).localeCompare(normalizeDate(a.data.date)));

const emailLink = profile.links.find((l) => l.url.startsWith('mailto:'));
const dialogAttrs = { closedby: 'any' } as Record<string, string>;
const targetLocale: Locale = locale === 'zh' ? 'en' : 'zh';

const pageRoutes = [
  { label: ui.nav.home, meta: localizePath('/', locale), href: localizePath('/', locale), keywords: 'home index frontispiece overview 首页' },
  { label: ui.nav.projects, meta: localizePath('/projects', locale), href: localizePath('/projects', locale), keywords: 'projects research systems engineering 项目' },
  { label: ui.nav.papers, meta: localizePath('/papers', locale), href: localizePath('/papers', locale), keywords: 'papers publications working manuscripts bibtex 论文' },
  { label: ui.nav.thoughts, meta: localizePath('/thoughts', locale), href: localizePath('/thoughts', locale), keywords: 'thoughts essays notes reading blog 随笔 思考' },
  { label: ui.nav.about, meta: localizePath('/about', locale), href: localizePath('/about', locale), keywords: 'about bio education experience skills contact 关于' },
];

const inkEditions = [
  { id: 'plum', label: 'Dawn Plum', cn: '曙紫', keywords: 'ink accent theme color plum purple 曙紫 破晓 alba' },
  { id: 'cinnabar', label: 'Cinnabar Seal', cn: '朱砂', keywords: 'ink accent theme color red vermilion seal 朱砂 印章' },
  { id: 'celadon', label: 'Song Celadon', cn: '天青', keywords: 'ink accent theme color green jade teal 天青 宋瓷' },
  { id: 'noir', label: 'Ink Noir', cn: '松烟', keywords: 'ink accent theme color monochrome black minimal 松烟 黑白' },
];
---
<dialog id="commandPalette" class="cmd-dialog" lang={locale === 'zh' ? 'zh-CN' : 'en'} aria-labelledby="cmdDialogTitle" {...dialogAttrs}>
  <div class="cmd-surface">
    <div class="cmd-header">
      <h2 id="cmdDialogTitle" class="sr-only">{ui.cmd.dialogTitle}</h2>
      <span class="cmd-search-icon" aria-hidden="true">
        <Icon name="search" size={16} />
      </span>
      <input
        id="cmdSearchInput"
        class="cmd-input"
        type="search"
        placeholder={ui.cmd.placeholder}
        autocomplete="off"
        spellcheck="false"
        autofocus
        aria-label={ui.cmd.filterAria}
      />
      <button type="button" class="cmd-close" id="cmdCloseBtn" aria-label={ui.cmd.closeAria}>
        <Icon name="close" size={16} />
      </button>
    </div>

    <div class="cmd-body" id="cmdResults">
      <section class="cmd-group" data-cmd-group>
        <h3 class="cmd-group-title">{ui.cmd.pages}</h3>
        <ul class="cmd-list">
          {pageRoutes.map((route) => (
            <li>
              <a
                class="cmd-item"
                href={route.href}
                data-cmd-item
                data-cmd-search={`${route.label} ${route.meta} ${route.keywords}`.toLowerCase()}
              >
                <span class="cmd-item-main">
                  <span class="cmd-item-title">{route.label}</span>
                </span>
                <span class="cmd-item-meta tabular">{route.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {papers.length > 0 && (
        <section class="cmd-group" data-cmd-group>
          <h3 class="cmd-group-title">{ui.cmd.papers}</h3>
          <ul class="cmd-list">
            {papers.map((paper) => (
              <li>
                <a
                  class="cmd-item"
                  href={localizePath(`/papers#${paper.id}`, locale)}
                  data-cmd-item
                  data-cmd-search={`${paper.title} ${paper.venue} ${paper.year} ${paper.tags.join(' ')} paper 论文`.toLowerCase()}
                >
                  <span class="cmd-item-main">
                    <span class="cmd-item-title">{paper.title}</span>
                    <span class="cmd-item-sub">{paper.status || paper.venue}</span>
                  </span>
                  <span class="cmd-item-meta tabular">{paper.year}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {projects.length > 0 && (
        <section class="cmd-group" data-cmd-group>
          <h3 class="cmd-group-title">{ui.cmd.projects}</h3>
          <ul class="cmd-list">
            {projects.map((project) => (
              <li>
                <a
                  class="cmd-item"
                  href={localizePath(`/projects#${project.id}`, locale)}
                  data-cmd-item
                  data-cmd-search={`${project.name} ${project.subtitle} ${project.tags.join(' ')} project 项目`.toLowerCase()}
                >
                  <span class="cmd-item-main">
                    <span class="cmd-item-title">{project.name}</span>
                    {project.subtitle && <span class="cmd-item-sub">{project.subtitle}</span>}
                  </span>
                  <span class="cmd-item-meta tabular">{project.year}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {thoughts.length > 0 && (
        <section class="cmd-group" data-cmd-group>
          <h3 class="cmd-group-title">{ui.cmd.thoughts}</h3>
          <ul class="cmd-list">
            {thoughts.map((thought) => {
              const dateIso = normalizeDate(thought.data.date);
              return (
                <li>
                  <a
                    class="cmd-item"
                    href={localizePath(`/thoughts/${thought.slug}`, locale)}
                    data-cmd-item
                    data-cmd-search={`${thought.data.title} ${thought.data.subtitle ?? ''} ${thought.data.caseId ?? ''} ${thought.data.tags.join(' ')} thought essay 随笔`.toLowerCase()}
                  >
                    <span class="cmd-item-main">
                      <span class="cmd-item-title" lang={thought.data.lang === 'zh' ? 'zh-CN' : 'en'}>
                        {thought.data.title}
                      </span>
                      {thought.data.subtitle && (
                        <span class="cmd-item-sub" lang={thought.data.lang === 'zh' ? 'zh-CN' : 'en'}>
                          {thought.data.subtitle}
                        </span>
                      )}
                    </span>
                    <span class="cmd-item-meta tabular">{dateIso}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <section class="cmd-group" data-cmd-group>
        <h3 class="cmd-group-title">{ui.cmd.actions}</h3>
        <ul class="cmd-list">
          <li>
            <a
              class="cmd-item"
              href={alternateHref}
              data-cmd-item
              data-lang-switch={targetLocale}
              data-cmd-search="language switch chinese english zh en 语言 切换 中文 英文"
            >
              <span class="cmd-item-main">
                <span class="cmd-item-title">{ui.cmd.switchLangTitle}</span>
                <span class="cmd-item-sub">{ui.cmd.switchLangSub}</span>
              </span>
              <span class="cmd-item-meta">{ui.cmd.switchLangMeta}</span>
            </a>
          </li>

          <li>
            <button
              type="button"
              class="cmd-item"
              data-cmd-item
              data-cmd-action="toggle-theme"
              data-cmd-search="toggle theme light dark paper charcoal dawn aperture appearance 切换 主题 深色 浅色"
            >
              <span class="cmd-item-main">
                <span class="cmd-item-title">{ui.cmd.toggleThemeTitle}</span>
                <span class="cmd-item-sub">{ui.cmd.toggleThemeSub}</span>
              </span>
              <span class="cmd-item-meta">{ui.cmd.toggleThemeMeta}</span>
            </button>
          </li>

          {inkEditions.map((ink) => (
            <li>
              <button
                type="button"
                class="cmd-item"
                data-cmd-item
                data-cmd-action={`set-ink:${ink.id}`}
                data-cmd-ink={ink.id}
                aria-pressed={ink.id === 'plum' ? 'true' : 'false'}
                data-cmd-search={`${ink.label} ${ink.cn} ${ink.keywords}`.toLowerCase()}
              >
                <span class="cmd-item-main cmd-item-main--inline">
                  <span class={`ink-dot ink-dot--${ink.id}`} aria-hidden="true"></span>
                  <span class="cmd-item-title">
                    {ui.cmd.inkPrefix}{locale === 'zh' ? ink.cn : ink.label}{' '}
                    <span class="cmd-item-cn" lang={locale === 'zh' ? 'en' : 'zh-CN'}>
                      {locale === 'zh' ? ink.label : ink.cn}
                    </span>
                  </span>
                </span>
                <span class="cmd-item-meta cmd-ink-active" aria-hidden="true">
                  <Icon name="check" size={14} />
                </span>
              </button>
            </li>
          ))}

          {emailLink && (
            <li>
              <button
                type="button"
                class="cmd-item"
                data-cmd-item
                data-cmd-action="copy-email"
                data-cmd-value={emailLink.handle}
                data-cmd-search={`copy email contact address ${emailLink.handle} 邮箱 复制`.toLowerCase()}
              >
                <span class="cmd-item-main">
                  <span class="cmd-item-title">{ui.cmd.copyEmailTitle}</span>
                  <span class="cmd-item-sub tabular">{emailLink.handle}</span>
                </span>
                <span class="cmd-item-meta">{ui.cmd.copyEmailMeta}</span>
              </button>
            </li>
          )}

          <li>
            <button
              type="button"
              class="cmd-item"
              data-cmd-item
              data-cmd-action="pet-wave"
              data-cmd-search="greet pixel mouse companion wave pet 老鼠 互动 招手"
            >
              <span class="cmd-item-main">
                <span class="cmd-item-title">{ui.cmd.petTitle}</span>
                <span class="cmd-item-sub">{ui.cmd.petSub}</span>
              </span>
              <span class="cmd-item-meta">{ui.cmd.petMeta}</span>
            </button>
          </li>
        </ul>
      </section>

      <p class="cmd-empty" id="cmdEmpty" hidden>
        {ui.cmd.empty}
      </p>
    </div>

    <p class="sr-only" id="cmdStatus" role="status" aria-live="polite"></p>

    <div class="cmd-footer" aria-hidden="true">
      <span class="cmd-hint">
        <kbd><Icon name="arrow-up" size={11} /></kbd><kbd><Icon name="arrow-down" size={11} /></kbd> {ui.cmd.hintNavigate}
      </span>
      <span class="cmd-hint">
        <kbd><Icon name="corner-down-left" size={11} /></kbd> {ui.cmd.hintOpen}
      </span>
      <span class="cmd-hint">
        <kbd>Esc</kbd> {ui.cmd.hintClose}
      </span>
    </div>
  </div>
</dialog>
