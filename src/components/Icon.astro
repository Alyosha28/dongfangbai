---
export type IconName = 'arrow-up-right' | 'arrow-right' | 'arrow-left' | 'arrow-up' | 'arrow-down' | 'copy' | 'check' | 'pause' | 'play' | 'menu' | 'moon' | 'sun' | 'seal' | 'search' | 'close' | 'command' | 'link' | 'corner-down-left' | 'dawn';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 15, class: className } = Astro.props;
---
{name === 'arrow-up-right' && (
  <svg class:list={['ui-icon', 'ui-icon--ext', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M5.25 10.75L10.75 5.25M6 5.25H10.75V10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'arrow-right' && (
  <svg class:list={['ui-icon', 'ui-icon--next', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3.5 8H12.25M8.75 4.5L12.25 8L8.75 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'arrow-left' && (
  <svg class:list={['ui-icon', 'ui-icon--prev', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M12.5 8H3.75M7.25 4.5L3.75 8L7.25 11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'arrow-up' && (
  <svg class:list={['ui-icon', 'ui-icon--up', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M8 12.5V3.75M4.5 7.25L8 3.75L11.5 7.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'arrow-down' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M8 3.5V12.25M4.5 8.75L8 12.25L11.5 8.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'copy' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="5.5" y="5.5" width="7.5" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4" />
    <path d="M10.5 5.5V3.75C10.5 3.06 9.94 2.5 9.25 2.5H3.75C3.06 2.5 2.5 3.06 2.5 3.75V9.25C2.5 9.94 3.06 10.5 3.75 10.5H5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
)}
{name === 'check' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3.5 8.5L6.5 11.5L12.75 4.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'pause' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M5.75 3.75V12.25M10.25 3.75V12.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
)}
{name === 'play' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M5.25 3.75L12.25 8L5.25 12.25V3.75Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
  </svg>
)}
{name === 'menu' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M2.5 4.5H13.5M2.5 8H13.5M2.5 11.5H13.5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
  </svg>
)}
{name === 'moon' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M13.2 9.9A5.5 5.5 0 0 1 6.1 2.8a5.5 5.5 0 1 0 7.1 7.1Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
  </svg>
)}
{name === 'sun' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="2.75" stroke="currentColor" stroke-width="1.4" />
    <path d="M8 1.5V3M8 13V14.5M1.5 8H3M13 8H14.5M3.4 3.4L4.45 4.45M11.55 11.55L12.6 12.6M12.6 3.4L11.55 4.45M4.45 11.55L3.4 12.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
)}
{name === 'search' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="7.25" cy="7.25" r="4.5" stroke="currentColor" stroke-width="1.4" />
    <path d="M10.65 10.65L13.75 13.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
)}
{name === 'close' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
  </svg>
)}
{name === 'command' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M6 6V4.25a1.75 1.75 0 1 0-1.75 1.75H6Zm0 0h4m-4 0v4m0 0H4.25A1.75 1.75 0 1 0 6 11.75V10Zm4-4V4.25a1.75 1.75 0 1 1 1.75 1.75H10Zm0 0v4m0 0h1.75A1.75 1.75 0 1 1 10 11.75V10Zm0 0H6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'link' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M6.75 9.25L9.25 6.75M5.4 7.5L4.05 8.85a2.35 2.35 0 0 0 3.32 3.32L8.7 10.85M7.3 5.15L8.63 3.83a2.35 2.35 0 0 1 3.32 3.32L10.6 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'corner-down-left' && (
  <svg class:list={['ui-icon', className]} width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M12.5 3.75V8.5a1.5 1.5 0 0 1-1.5 1.5H3.75M6.75 7L3.75 10L6.75 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === 'dawn' && (
  <svg class:list={['ui-icon', className]} width={size} height={Math.round(size / 2)} viewBox="0 0 32 16" fill="none" aria-hidden="true">
    <path d="M2 13.5H30" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" opacity="0.45" />
    <path d="M9.5 13.5a6.5 6.5 0 0 1 13 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
    <circle cx="16" cy="3.5" r="1" fill="currentColor" opacity="0.65" />
  </svg>
)}
{name === 'seal' && (
  <svg class:list={['ui-seal', className]} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="1.25" y="1.25" width="21.5" height="21.5" rx="3.5" stroke="currentColor" stroke-width="1.3" />
    <text x="12" y="16.2" text-anchor="middle" fill="var(--text, currentColor)" font-family="'Noto Serif SC', 'Songti SC', Georgia, serif" font-size="12" font-weight="600">白</text>
  </svg>
)}
