---
import Icon from './Icon.astro';
import type { Paper } from '../lib/data';
import { getProfile, tokenizeAuthors } from '../lib/data';
import { getUi, localizePath, type Locale } from '../lib/i18n';

export interface Props {
  paper: Paper;
  locale?: Locale;
  showDetails?: boolean;
  headingLevel?: 'h2' | 'h3';
  linkToDetail?: boolean;
  compact?: boolean;
  showSummary?: boolean;
}

const {
  paper,
  locale = 'en',
  showDetails = true,
  headingLevel = 'h3',
  linkToDetail = false,
  compact = false,
  showSummary = true,
} = Astro.props;
const ui = getUi(locale);
const HeadingTag = headingLevel;
const profile = getProfile(locale);
const authorTokens = tokenizeAuthors(paper.authors, profile.name);
const isSoloOwner = authorTokens.length === 1 && authorTokens[0].isOwner;
const hasCoauthors = authorTokens.length > 0 && !isSoloOwner;
const normalizedStatus = paper.status.trim().toLowerCase();
const normalizedVenue = paper.venue.trim().toLowerCase();
const showVenue = Boolean(
  normalizedVenue &&
    normalizedVenue !== normalizedStatus &&
    !(locale === 'zh' && (normalizedVenue === 'working paper' || normalizedVenue === 'under review'))
);
const showByline = hasCoauthors || showVenue;
---
<article class:list={['ledger-item', { 'ledger-item--compact': compact && !showSummary }]} id={showDetails ? paper.id : undefined}>
  <div class="ledger-meta">
    <span class="tabular ledger-year">{paper.year}</span>
    {paper.status && <span class="ledger-status">{paper.status}</span>}
  </div>

  <div class="ledger-body">
    <HeadingTag class="item-title" lang="en">
      {linkToDetail ? (
        <a href={localizePath(`/papers#${paper.id}`, locale)}>{paper.title}</a>
      ) : (
        paper.title
      )}
    </HeadingTag>

    {showByline && (
      <p class="item-authors">
        {hasCoauthors &&
          authorTokens.map((author, idx) => (
            <>
              {idx > 0 && ', '}
              {author.isOwner ? <strong>{author.name}</strong> : author.name}
            </>
          ))}
        {hasCoauthors && paper.authorNote && <span class="meta-sep">· {paper.authorNote}</span>}
        {showVenue && (
          hasCoauthors ? <span class="meta-sep">· {paper.venue}</span> : <span>{paper.venue}</span>
        )}
      </p>
    )}

    {showSummary && <p class="item-summary">{paper.summary}</p>}

    {!compact && paper.tags.length > 0 && (
      <ul class="item-tags" aria-label={ui.papers.topicsAria}>
        {paper.tags.map((tag) => <li class="tag-term">{tag}</li>)}
      </ul>
    )}

    {!compact && paper.links.length > 0 && (
      <div class="item-actions">
        {paper.links.map((link) => {
          const isExternal = link.url.startsWith('http');
          const openInNewTab = isExternal || link.url.endsWith('.pdf');
          return (
            <a
              class="action-link"
              href={link.url}
              target={openInNewTab ? '_blank' : undefined}
              rel={openInNewTab ? 'noopener noreferrer' : undefined}
            >
              <span>{link.label}</span>
              {openInNewTab && <Icon name="arrow-up-right" size={14} />}
            </a>
          );
        })}
      </div>
    )}

    {showDetails && (paper.abstract || paper.bibtex) && (
      <div class="item-disclosures">
        {paper.abstract && (
          <details class="disclosure">
            <summary>{ui.papers.abstract}</summary>
            <div class="disclosure-panel" lang="en">
              <p>{paper.abstract}</p>
            </div>
          </details>
        )}

        {paper.bibtex && (
          <details class="disclosure">
            <summary>{ui.papers.bibtex}</summary>
            <div class="disclosure-panel">
              <pre class="bibtex-pre" tabindex="0"><code>{paper.bibtex.trim()}</code></pre>
              <div class="bibtex-toolbar">
                <button
                  type="button"
                  class="copy-btn"
                  data-copy-text={paper.bibtex.trim()}
                  data-copy-label={ui.papers.bibtexCopied}
                >
                  <span class="copy-icon-default" aria-hidden="true"><Icon name="copy" size={14} /></span>
                  <span class="copy-icon-done" aria-hidden="true"><Icon name="check" size={14} /></span>
                  <span class="copy-btn-label">{ui.papers.copyBibtex}</span>
                </button>
                <span class="copy-status" role="status" aria-live="polite"></span>
              </div>
            </div>
          </details>
        )}
      </div>
    )}
  </div>
</article>
